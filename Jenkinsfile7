pipeline {
    agent any
    environment {
        IMAGE_NAME = "selenium-test"
    }
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    // Build the Docker image
                    sudo sh 'docker build -t $IMAGE_NAME .'
                }
            }
        }
        stage('Run Selenium Tests') {
            steps {
                script {
                    // Run the Docker container and execute the tests
                    sudo sh 'docker run --rm $IMAGE_NAME'
                }
            }
        }
    }
    post {
        always {
            // Cleanup: remove any unused images, volumes, etc.
            sudo sh 'docker system prune -af'
        }
    }
}
